PUBLIC_URL=https://notes.example.com
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
ALLOWED_USER_IDS=
GROQ_API_KEY=
# OpenAI-compatible base URL, INCLUDING /v1 if your 9router endpoint uses it
NINEROUTER_BASE_URL=http://NINEROUTER_INTERNAL_HOST:PORT/v1
