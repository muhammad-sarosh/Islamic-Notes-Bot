      "name": "Check discord messages"
    },
    {
      "parameters": {
        "jsCode": "const message = $input.first().json;\n\n// Only accept !createnotes\nif (\n  typeof message.content !== 'string' ||\n  !message.content.trim().toLowerCase().startsWith('!createnotes')\n) {\n  return [];\n}\n\nconst state = $getWorkflowStaticData('global');\n\n// Ignore already-processed command\nif (state.lastProcessedMessageId === message.id) {\n  return [];\n}\n\nconst parts = message.content.trim().split(/\\s+/).slice(1);\n\nlet youtube_url = null;\nlet course = null;\nlet lecture_number = null;\n\nfor (const part of parts) {\n  // YouTube URL\n  if (\n    /^https?:\\/\\/(www\\.)?(youtube\\.com|youtu\\.be)\\//i.test(part)\n  ) {\n    youtube_url = part;\n    continue;\n  }\n\n  // Lecture number: 1/1, 2/7, etc.\n  if (/^\\d+\\/\\d+$/.test(part)) {\n    lecture_number = part;\n    continue;\n  }\n\n  // Remaining word = course\n  if (!course) {\n    course = part.toLowerCase();\n  }\n}\n\nif (!youtube_url || !course || !lecture_number) {\n  throw new Error(`Invalid !createnotes command: \"${message.content}\"`);\n}\n\nreturn [{\n  json: {\n    youtube_url,\n    course,\n    lecture_number,\n    discord_message_id: message.id,\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -288,
        0
      ],
      "id": "ed285b22-35a7-4aa1-b81f-fd72406a7384",
      "name": "Extract data"
    },
    {
      "parameters": {
        "jsCode": "const state = $getWorkflowStaticData('global');\n\nconst data = $('Extract data').first().json;\n\nstate.lastProcessedMessageId = data.discord_message_id;\n\nreturn $input.all();"
      },
