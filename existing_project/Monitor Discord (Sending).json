      "name": "Check discord messages"
    },
    {
      "parameters": {
        "jsCode": "const message = $input.first().json;\n\n// Only accept !sendnotes\nif (\n  typeof message.content !== 'string' ||\n  !message.content.trim().toLowerCase().startsWith('!sendnotes')\n) {\n  return [];\n}\n\nconst state = $getWorkflowStaticData('global');\n\n// Already processed\nif (state.lastProcessedMessageId === message.id) {\n  return [];\n}\n\nconst parts = message.content.trim().split(/\\s+/).slice(1);\n\nlet course = null;\nlet lecture_number = null;\nlet run_id = null;\n\nfor (const part of parts) {\n  if (/^\\d+\\/\\d+$/.test(part)) {\n    lecture_number = part;\n  } else if (/^\\d+$/.test(part)) {\n    run_id = part;\n  } else if (!course) {\n    course = part.toLowerCase();\n  }\n}\n\nif (!course || !lecture_number || !run_id) {\n  throw new Error(`Invalid command: \"${message.content}\"`);\n}\n\nreturn [{\n  json: {\n    course,\n    lecture_number,\n    run_id,\n    discord_message_id: message.id,\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        -208
      ],
      "id": "35313c45-272c-4298-888c-2da076316b44",
      "name": "Extract data"
    },
    {
      "parameters": {
        "jsCode": "const state = $getWorkflowStaticData('global');\n\nconst data = $('Extract data').first().json;\n\nstate.lastProcessedMessageId = data.discord_message_id;\n\nreturn $input.all();"
      },
